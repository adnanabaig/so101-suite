# Optional overrides for the browser-local MediaPipe hand tracker. Defaults use
# the published jsDelivr WASM files and Google's hand_landmarker task model.
VITE_MEDIAPIPE_WASM_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@1.0.1/wasm
VITE_HAND_LANDMARKER_MODEL_URL=https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task

# Used only by the Vite development proxy. Read from frontend/.env (or .env.local)
# or the environment, which wins; Docker Compose sets it to the api service.
VITE_DEV_API_TARGET=http://localhost:8000
