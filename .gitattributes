# Line endings. The repository stores LF, and checkouts keep LF on every OS
# (overriding Git for Windows' core.autocrlf=true), so a Windows clone can still
# run install/install.sh under WSL or Linux, build the Docker images, and share
# a dual-boot partition. Windows scripts are checked out with CRLF.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never convert line endings or diff as text.
*.stl binary
*.obj binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.parquet binary
*.safetensors binary
*.pt binary
*.pth binary
*.npy binary
*.npz binary
*.sqlite3 binary
*.whl binary
