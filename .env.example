# Copy to .env and adjust. All vars are prefixed SO101_.
#
# Where settings come from, highest priority first: SO101_* environment
# variables, .env in the folder a command runs in, .env in the data folder
# (SO101_HOME, else ~/.local/share/so101 on Linux), then the defaults. The
# installer puts the data folder's .env in place (docs/install.md).

# --- Hardware -----------------------------------------------------------
# Force mock mode (no serial/cameras/LeRobot needed). Great for dev + CI.
SO101_MOCK=0
# Serial ports for the Feetech bus servo adapters. Linux: unset means
# /dev/so101-follower and /dev/so101-leader, the names install/install.sh
# --follower-serial S --leader-serial S gives the adapters (and sets in the data
# folder's .env); otherwise `ls /dev/ttyACM* /dev/ttyUSB*`. macOS:
# `ls /dev/tty.usbmodem*`. Windows: COM3 and the like.
SO101_FOLLOWER_PORT=/dev/tty.usbmodemXXXX
SO101_LEADER_PORT=/dev/tty.usbmodemYYYY
# Stable LeRobot calibration identities for these exact devices.
SO101_FOLLOWER_ID=so101-follower
SO101_LEADER_ID=so101-leader
# Leader teleop command slew; angular joints deg/s, gripper percentage points/s.
# The scoped LeRobot target profile preserves SafetyGuard position and step limits.
SO101_TELEOP_MAX_VELOCITY_DEG_S=60
SO101_BAUDRATE=1000000
# Comma-separated camera entries; `make find-cameras` lists what is attached.
#   0,1                            two OpenCV cameras by index (or a device path/URL)
#   realsense                      the only attached Intel RealSense, color 640x480@30
#   realsense:123622270882+depth   a RealSense by serial, plus depth aligned to color
#   wrist=realsense:123622270882:848x480@30   "wrist=" names the recorded feature
# Grammar, depth units and per-OS setup: docs/realsense.md.
SO101_CAMERAS=0
# shared: relay-owned cameras with MCAP episode capture; native camera operations are refused.
SO101_CAMERA_CAPTURE_MODE=direct
# OpenCV requests; drivers can negotiate a different mode. Remove these four
# entries to use device defaults. MJPG reduces bandwidth for multiple cameras.
SO101_CAMERA_WIDTH=640
SO101_CAMERA_HEIGHT=480
SO101_CAMERA_FPS=30
SO101_CAMERA_FOURCC=MJPG
# What backs the robot: mock, sim (MuJoCo physics, needs the [sim] extra) or
# real. Empty follows SO101_MOCK. SO101_MOCK=1 with sim or real is an error.
SO101_BACKEND=

# --- Simulation (docs/simulation.md) -------------------------------------
# /api/simulation engine: auto, kinematic or mujoco. auto serves MuJoCo
# physics when the [sim] extra is installed.
SO101_SIM_ENGINE=auto
# reach, pick_lift or pick_place.
SO101_SIM_TASK=pick_lift
SO101_SIM_SEED=0
# Comma-separated simulated camera names, and their frame size as WxH.
SO101_SIM_CAMERAS=front,wrist_cam
SO101_SIM_IMAGE_SIZE=320x240
# Pace the sim backend's physics to the wall clock.
SO101_SIM_REALTIME=1

# --- Bring-up: servo health (docs/bring-up.md) ---------------------------
# Suite defaults, not Feetech specifications. 7.4v is the standard STS3215
# (the SO-101 kit powers it from 5 V); 12v is the high-torque variant on a
# 12 V supply. Select each arm's actual motor rating, including the leader.
SO101_HEALTH_FOLLOWER_SUPPLY=7.4v
SO101_HEALTH_LEADER_SUPPLY=7.4v
# Volts as a JSON list: [critical_low, warn_low, warn_high, critical_high].
SO101_HEALTH_SUPPLY_BAND_7V4=[4.0,4.5,8.0,8.5]
SO101_HEALTH_SUPPLY_BAND_12V=[9.5,10.5,13.0,14.0]
# Temperature thresholds sit this far below the servo's Max_Temperature_Limit
# register when it reads back plausibly; otherwise the fallbacks apply.
SO101_HEALTH_TEMP_WARN_MARGIN_C=15
SO101_HEALTH_TEMP_CRITICAL_MARGIN_C=5
SO101_HEALTH_TEMP_FALLBACK_WARN_C=55
SO101_HEALTH_TEMP_FALLBACK_CRITICAL_C=65
# Load and current thresholds; empty (or none/off) disables one.
SO101_HEALTH_LOAD_WARN_PCT=80
SO101_HEALTH_LOAD_CRITICAL_PCT=
SO101_HEALTH_CURRENT_WARN_MA=2000
SO101_HEALTH_CURRENT_CRITICAL_MA=
# Level for a nonzero servo Status register: ok, warn or critical.
SO101_HEALTH_STATUS_NONZERO_LEVEL=warn
# Poll rate (1-2 Hz), and failed reads in a row before a servo is critical.
SO101_HEALTH_POLL_HZ=1
SO101_HEALTH_MAX_CONSECUTIVE_FAILURES=3

# --- Bring-up: rest pose for the Collapse stop ---------------------------
# Six values in joint order (degrees; gripper 0-100) or a JSON object keyed by
# joint name, for example "0,-95,92.8,-85,0,5" (the model-derived default).
# Empty = the pose `so101 rest-pose record` saved, else that default. Record
# your own arm's pose rather than typing one.
SO101_REST_POSE=

# --- Stops: Halt and Collapse (docs/control-plane-safety.md) ------------
# A halt holds position for at most this many seconds, then collapses.
SO101_HALT_HOLD_SECONDS=60
# With no fresh operator heartbeat, a halt holds only this long.
SO101_SUPERVISION_GRACE_SECONDS=5
# Collapse lowers the arm to the rest pose at most this fast, per joint.
SO101_COLLAPSE_SPEED_DEG_S=15
# Bound on the Collapse descent in seconds, at most 12. Empty = distance /
# speed + 2 s, capped at 12.
SO101_COLLAPSE_TIMEOUT_SECONDS=
# Halt grip rule, 0..100 gripper units: the gripper never opens and squeezes
# at most this far below where it is.
SO101_GRIP_HOLD_MARGIN=5

# --- Storage ------------------------------------------------------------
# Relative paths are taken from the folder a command runs in. The installer
# writes absolute ones into the data folder's .env, so the installed suite
# keeps its data there from any folder.
SO101_DATA_DIR=./data
SO101_DATASETS_DIR=./datasets
SO101_OUTPUTS_DIR=./outputs

# --- Service ------------------------------------------------------------
SO101_HOST=127.0.0.1
SO101_PORT=8000
SO101_LOG_LEVEL=INFO
# Explicit browser origins allowed to call the API. Add the trusted HTTPS
# origin used by Quest Browser; do not use `*` on a robot host.
SO101_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Extra Host header names the server answers to, comma-separated (e.g. the
# robot host's LAN name). localhost, 127.0.0.1 and ::1 are always allowed;
# `*` is refused. See docs/control-plane-security.md.
SO101_ALLOWED_HOSTS=
# Test harness only: ephemeral installed-artifact identity nonce. Leave empty
# for every operator/development/production server.
SO101_E2E_TOKEN=
# Built web UI directory containing index.html. Empty = the UI packaged in the
# wheel, then the checkout's frontend/dist.
SO101_UI_DIR=

# --- Hugging Face (optional, for pushing datasets / pulling policies) ---
SO101_HF_TOKEN=
SO101_HF_USER=

# --- Training (optional) ------------------------------------------------
SO101_WANDB_PROJECT=so101
SO101_WANDB_ENABLED=0
# Policy inference device. Empty (or auto) picks cuda, then mps, then cpu;
# cpu, cuda, cuda:<n> or mps forces one and fails if it is unavailable.
SO101_POLICY_DEVICE=

# --- Optional proposal-only model planner ------------------------------
# The model can select a named skill proposal only. It never receives a motor tool.
SO101_AGENT_PROVIDER=deterministic
SO101_AGENT_MODEL=
# Timeout in seconds for each request to the configured model planner.
SO101_AGENT_TIMEOUT_SECONDS=20
SO101_OPENAI_API_KEY=
SO101_OPENAI_BASE_URL=https://api.openai.com/v1
