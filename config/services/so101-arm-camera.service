[Unit]
Description=SO101 local OBSBOT arm camera relay
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/adnan/so101-suite
ExecStart=/usr/bin/env -u PYTHONPATH -u LEROBOT_HOME /home/adnan/so101-suite/.venv/bin/python -I /home/adnan/so101-suite/scripts/arm_camera.py --fps 30 --preview-fps 30
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=default.target
