# Example rig profile. Verify both physical USB roles before using real mode.
# Copy to the checkout's .env only after reviewing docs/bring-up.md.
SO101_MOCK=0
SO101_BACKEND=real
SO101_FOLLOWER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5C4C127110-if00
SO101_LEADER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5C4C125684-if00
# New identities protect the older toolkit's native calibration files.
SO101_FOLLOWER_ID=adnan-suite-follower
SO101_LEADER_ID=adnan-suite-leader
SO101_BAUDRATE=1000000
# Start without cameras; discover and identify them before enabling capture.
SO101_CAMERAS=
SO101_DATA_DIR=/home/adnan/so101-suite/data/real
SO101_DATASETS_DIR=/home/adnan/so101-suite/datasets/real
SO101_OUTPUTS_DIR=/home/adnan/so101-suite/outputs/real
SO101_HOST=127.0.0.1
SO101_PORT=8000
# Health supply bands intentionally omitted: select the matching variant after
# checking the motor/supply labels, using .env.example's documented settings.
