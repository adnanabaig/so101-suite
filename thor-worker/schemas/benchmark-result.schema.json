{
  "$id": "https://so101.local/schemas/thor-worker/benchmark-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "benchmark_contract.py additionally verifies config_sha256, exact config/result equality, rate/count/duration equations and numeric sample digests.",
  "$defs": {
    "baseEntry": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "passed"}}},
          "then": {
            "properties": {
              "diagnostic": {"type": "null"},
              "duration_seconds": {"exclusiveMinimum": 0, "type": "number"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "disabled"}}},
          "then": {
            "properties": {
              "correctness": {"maxProperties": 0},
              "diagnostic": {"type": "null"},
              "duration_seconds": {"const": 0},
              "metrics": {"maxProperties": 0}
            }
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["unavailable", "failed"]}}},
          "then": {
            "properties": {
              "correctness": {"maxProperties": 0},
              "diagnostic": {"minLength": 1, "type": "string"},
              "duration_seconds": {"const": 0},
              "metrics": {"maxProperties": 0}
            }
          }
        }
      ],
      "properties": {
        "correctness": {"type": "object"},
        "diagnostic": {"type": ["string", "null"]},
        "duration_seconds": {"minimum": 0, "type": "number"},
        "metrics": {"type": "object"},
        "name": {"enum": ["dataset", "torch", "inference", "sim"]},
        "parameters": {"type": "object"},
        "status": {"enum": ["passed", "unavailable", "failed", "disabled"]}
      },
      "required": [
        "name",
        "status",
        "parameters",
        "duration_seconds",
        "metrics",
        "correctness",
        "diagnostic"
      ],
      "type": "object"
    },
    "torchMetrics": {
      "additionalProperties": false,
      "properties": {
        "actual_device": {"enum": ["cpu", "cuda"]},
        "cublas_workspace_config": {"const": ":4096:8"},
        "deterministic_algorithms": {"const": true},
        "iterations": {"minimum": 1, "type": "integer"},
        "operations": {"minimum": 1, "type": "integer"},
        "operations_per_second": {"exclusiveMinimum": 0, "type": "number"},
        "seed": {"maximum": 4294967295, "minimum": 0, "type": "integer"},
        "tf32_allowed": {"const": false}
      },
      "required": [
        "actual_device",
        "iterations",
        "operations",
        "operations_per_second",
        "seed",
        "deterministic_algorithms",
        "tf32_allowed",
        "cublas_workspace_config"
      ],
      "type": "object"
    },
    "inferenceMetrics": {
      "additionalProperties": false,
      "properties": {
        "actual_device": {"enum": ["cpu", "cuda"]},
        "cublas_workspace_config": {"const": ":4096:8"},
        "deterministic_algorithms": {"const": true},
        "iterations": {"minimum": 1, "type": "integer"},
        "samples": {"minimum": 1, "type": "integer"},
        "samples_per_second": {"exclusiveMinimum": 0, "type": "number"},
        "seed": {"maximum": 4294967295, "minimum": 0, "type": "integer"},
        "tf32_allowed": {"const": false}
      },
      "required": [
        "actual_device",
        "iterations",
        "samples",
        "samples_per_second",
        "seed",
        "deterministic_algorithms",
        "tf32_allowed",
        "cublas_workspace_config"
      ],
      "type": "object"
    },
    "tensorCorrectness": {
      "additionalProperties": false,
      "properties": {
        "finite": {"const": true},
        "sample": {
          "items": {"type": "number"},
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "sample_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "sum": {"type": "number"}
      },
      "required": ["sample", "sample_sha256", "sum", "finite"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "benchmark_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "compatibility": {"$ref": "compatibility.schema.json"},
    "config": {"$ref": "benchmark-config.schema.json"},
    "config_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "finished_utc": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "results": {
      "items": false,
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/baseEntry"},
            {
              "properties": {
                "name": {"const": "dataset"},
                "parameters": {"$ref": "benchmark-config.schema.json#/$defs/datasetParameters"}
              }
            },
            {
              "if": {"properties": {"status": {"const": "passed"}}},
              "then": {
                "oneOf": [
                  {
                    "properties": {
                      "correctness": {
                        "additionalProperties": false,
                        "properties": {
                          "aggregate_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
                        },
                        "required": ["aggregate_sha256"],
                        "type": "object"
                      },
                      "metrics": {
                        "additionalProperties": false,
                        "properties": {
                          "bytes_per_second": {"exclusiveMinimum": 0, "type": "number"},
                          "bytes_processed": {"minimum": 1, "type": "integer"},
                          "iterations": {"minimum": 1, "type": "integer"},
                          "mode": {"const": "synthetic"},
                          "seed": {"maximum": 4294967295, "minimum": 0, "type": "integer"}
                        },
                        "required": ["iterations", "bytes_processed", "bytes_per_second", "mode", "seed"],
                        "type": "object"
                      },
                      "parameters": {"properties": {"mode": {"const": "synthetic"}}}
                    }
                  },
                  {
                    "properties": {
                      "correctness": {
                        "additionalProperties": false,
                        "properties": {
                          "aggregate_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
                          "dataset_manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
                        },
                        "required": ["aggregate_sha256", "dataset_manifest_sha256"],
                        "type": "object"
                      },
                      "metrics": {
                        "additionalProperties": false,
                        "properties": {
                          "bytes_per_second": {"exclusiveMinimum": 0, "type": "number"},
                          "bytes_processed": {"minimum": 1, "type": "integer"},
                          "files": {"minimum": 1, "type": "integer"},
                          "iterations": {"minimum": 1, "type": "integer"},
                          "mode": {"const": "artifact"},
                          "seed": {"maximum": 4294967295, "minimum": 0, "type": "integer"}
                        },
                        "required": ["iterations", "bytes_processed", "bytes_per_second", "mode", "seed", "files"],
                        "type": "object"
                      },
                      "parameters": {"properties": {"mode": {"const": "artifact"}}}
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/baseEntry"},
            {
              "properties": {
                "name": {"const": "torch"},
                "parameters": {"$ref": "benchmark-config.schema.json#/$defs/torchParameters"}
              }
            },
            {
              "if": {"properties": {"status": {"const": "passed"}}},
              "then": {
                "properties": {
                  "correctness": {"$ref": "#/$defs/tensorCorrectness"},
                  "metrics": {"$ref": "#/$defs/torchMetrics"}
                }
              }
            },
            {
              "if": {
                "properties": {
                  "parameters": {"properties": {"device": {"const": "cuda"}}},
                  "status": {"const": "passed"}
                }
              },
              "then": {
                "properties": {
                  "metrics": {"properties": {"actual_device": {"const": "cuda"}}}
                }
              }
            },
            {
              "if": {
                "properties": {
                  "parameters": {"properties": {"device": {"const": "cpu"}}},
                  "status": {"const": "passed"}
                }
              },
              "then": {
                "properties": {
                  "metrics": {"properties": {"actual_device": {"const": "cpu"}}}
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/baseEntry"},
            {
              "properties": {
                "name": {"const": "inference"},
                "parameters": {"$ref": "benchmark-config.schema.json#/$defs/inferenceParameters"}
              }
            },
            {
              "if": {"properties": {"status": {"const": "passed"}}},
              "then": {
                "properties": {
                  "correctness": {"$ref": "#/$defs/tensorCorrectness"},
                  "metrics": {"$ref": "#/$defs/inferenceMetrics"}
                }
              }
            },
            {
              "if": {
                "properties": {
                  "parameters": {"properties": {"device": {"const": "cuda"}}},
                  "status": {"const": "passed"}
                }
              },
              "then": {
                "properties": {
                  "metrics": {"properties": {"actual_device": {"const": "cuda"}}}
                }
              }
            },
            {
              "if": {
                "properties": {
                  "parameters": {"properties": {"device": {"const": "cpu"}}},
                  "status": {"const": "passed"}
                }
              },
              "then": {
                "properties": {
                  "metrics": {"properties": {"actual_device": {"const": "cpu"}}}
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/baseEntry"},
            {
              "properties": {
                "name": {"const": "sim"},
                "parameters": {"$ref": "benchmark-config.schema.json#/$defs/simParameters"}
              }
            },
            {
              "if": {"properties": {"status": {"const": "passed"}}},
              "then": {
                "properties": {
                  "correctness": {
                    "additionalProperties": false,
                    "properties": {
                      "final_qpos": {"type": "number"},
                      "final_qvel": {"type": "number"},
                      "finite": {"const": true}
                    },
                    "required": ["finite", "final_qpos", "final_qvel"],
                    "type": "object"
                  },
                  "metrics": {
                    "additionalProperties": false,
                    "properties": {
                      "seed": {"maximum": 4294967295, "minimum": 0, "type": "integer"},
                      "steps": {"minimum": 1, "type": "integer"},
                      "steps_per_second": {"exclusiveMinimum": 0, "type": "number"}
                    },
                    "required": ["steps", "steps_per_second", "seed"],
                    "type": "object"
                  }
                }
              }
            }
          ]
        }
      ],
      "type": "array"
    },
    "run_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "schema_version": {"const": 1},
    "seed": {"maximum": 4294967295, "minimum": 0, "type": "integer"},
    "started_utc": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "benchmark_id",
    "run_id",
    "started_utc",
    "finished_utc",
    "compatibility",
    "config",
    "config_sha256",
    "seed",
    "results"
  ],
  "title": "SO-101 worker benchmark result",
  "type": "object"
}
